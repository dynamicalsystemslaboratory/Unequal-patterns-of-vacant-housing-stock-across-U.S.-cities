   RowBox[{
    SuperscriptBox["\[Omega]", "TC"], ">", "\[Omega]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e72c463-4145-9e4f-a98f-a8e036be316d"],
 " yields 0<a0<a1."
}], "Text",
