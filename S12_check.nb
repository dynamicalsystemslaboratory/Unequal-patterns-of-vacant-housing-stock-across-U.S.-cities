Cell[TextData[{
 "The time derivative of the Lyapunov function is strictly negative when \
\[Omega] ",
 Cell[BoxData[
  FormBox[
   RowBox[{">", 
    SuperscriptBox["\[Omega]", "TC"]}], TraditionalForm]],ExpressionUUID->
  "c7c02547-6a9c-e148-94c5-827ba164e40f"],
 ", Meaning that we have asymptotic stability. Note that this is true for \
V/H<1. In EQ, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", "*"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e039dcbc-aae4-864b-8f05-792ec1e9800f"],
 "=H, thus V/H=1, and we get that the derivative is 0."
}], "Text",
 CellChangeTimes->{{3.971526702305052*^9, 3.971526760117037*^9}, {
  3.972560921934288*^9, 
  3.9725609664408493`*^9}},ExpressionUUID->"00c5227e-599e-1042-8580-\
86a007f51f53"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

